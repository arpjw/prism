{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PricePoint",
  "type": "object",
  "required": ["timestamp", "price", "slug", "source"],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "price": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "volume": {"type": "integer", "minimum": 0},
    "slug": {"type": "string"},
    "source": {"type": "string"}
  }
}
